{
    "name": "porro/craft-connector",
    "description": "Site health, suspicious activity and IP blocking for Craft CMS 4–5, in the control panel: security advisories, end-of-life PHP and Craft, updates, dev mode, migrations and the queue, plus probes, failed sign-ins and form floods, blocked in Craft, at Cloudflare or in nginx. Free; connect Porro to add uptime, SSL, domain and server checks.",
    "type": "craft-plugin",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "site health",
        "security",
        "advisories",
        "end of life",
        "updates",
        "monitoring",
        "blocking",
        "firewall",
        "cloudflare",
        "porro"
    ],
    "support": {
        "issues": "https://github.com/Porrodev/craft-connector/issues",
        "source": "https://github.com/Porrodev/craft-connector",
        "docs": "https://github.com/Porrodev/craft-connector#readme"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^4.0|^5.0",
        "porro/php-core": "^0.3.1"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "porro\\craft\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "porro\\craft\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "porro",
        "name": "Porro Site Health",
        "developer": "Porro",
        "developerUrl": "https://porro.dev",
        "documentationUrl": "https://github.com/Porrodev/craft-connector",
        "class": "porro\\craft\\Plugin",
        "description": "Site health, suspicious activity and IP blocking in your control panel: advisories, end-of-life versions and updates, plus probes and failed sign-ins, blocked in Craft, at Cloudflare or in nginx. Free; connect Porro for uptime, SSL, domain and server checks too.",
        "changelogUrl": "https://raw.githubusercontent.com/Porrodev/craft-connector/main/CHANGELOG.md"
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Porro",
            "homepage": "https://porro.dev"
        }
    ]
}
