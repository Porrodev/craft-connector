{
    "name": "porro/craft-connector",
    "description": "Site health for Craft CMS 4–5: security advisories, end-of-life PHP and Craft, updates, dev mode, migrations and the queue, in a control panel section and dashboard widget. Free; connect Porro to add uptime, SSL, domain and server checks.",
    "type": "craft-plugin",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "site health",
        "security",
        "advisories",
        "end of life",
        "updates",
        "monitoring",
        "porro"
    ],
    "support": {
        "issues": "https://github.com/Porrodev/craft-connector/issues",
        "source": "https://github.com/Porrodev/craft-connector",
        "docs": "https://github.com/Porrodev/craft-connector#readme"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^4.0|^5.0",
        "porro/php-core": "^0.2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "porro\\craft\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "porro\\craft\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "porro",
        "name": "Porro Site Health",
        "developer": "Porro",
        "developerUrl": "https://porro.dev",
        "documentationUrl": "https://github.com/Porrodev/craft-connector",
        "class": "porro\\craft\\Plugin",
        "description": "Security advisories, end-of-life versions, updates and site health, checked inside your site. Connect Porro for uptime, SSL, domain and server checks too.",
        "changelogUrl": "https://raw.githubusercontent.com/Porrodev/craft-connector/main/CHANGELOG.md"
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "name": "core",
            "type": "path",
            "url": "../../../../porro-php-core/.claude/worktrees/site-health",
            "options": {
                "symlink": true,
                "versions": {
                    "porro/php-core": "0.2.0"
                }
            }
        }
    ],
    "authors": [
        {
            "name": "Porro",
            "homepage": "https://porro.dev"
        }
    ]
}
