{# Shared by the Activity and Blocking pages: Craft's own look, with a few extras. #}
{% css %}
    .porro-page > * + * { margin-top: 24px; }
    .porro-head { display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
    .porro-sub { margin: 4px 0 0; }
    .porro-mono { font-family: var(--code-font, SFMono-Regular, Consolas, monospace); font-size: 0.92em; }
    .porro-anywhere { overflow-wrap: anywhere; }
    .porro-nowrap { white-space: nowrap; }
    .porro-pane { border: 1px solid var(--hairline-color, #e3e5e8); border-radius: var(--large-border-radius, 8px); overflow: hidden; }
    .porro-pane-head { display: flex; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--hairline-color, #e3e5e8); background: var(--gray-050, #f3f7fc); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--light-text-color, #606d7b); }
    .porro-pane-body { padding: 12px 16px; }
    .porro-pane > .data { border: 0; }
    .porro-pane .data th:first-child, .porro-pane .data td:first-child { padding-left: 16px; }
    .porro-pane .data th:last-child, .porro-pane .data td:last-child { padding-right: 16px; }
    .porro-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; padding: 12px 16px; }
    .porro-stat { padding: 10px 12px; border-radius: var(--medium-border-radius, 5px); background: var(--gray-050, #f3f7fc); }
    .porro-stat b { display: block; font-size: 20px; line-height: 1.3; }
    .porro-chip { display: inline-block; margin: 1px 4px 1px 0; padding: 0 6px; border: 1px solid var(--hairline-color, #cdd8e4); border-radius: 4px; font-family: var(--code-font, monospace); font-size: 11.5px; line-height: 18px; white-space: nowrap; }
    .porro-chip.danger { border-color: var(--error-color, #cf1124); color: var(--error-color, #cf1124); }
    .porro-chip.warning { border-color: var(--warning-color, #8b5800); color: var(--warning-color, #8b5800); }
    .porro-chip.on { border-color: var(--success-color, #006c45); color: var(--success-color, #006c45); }
    .porro-chip[aria-current] { border-color: var(--text-color, #3f4d5a); background: var(--gray-100, #e4edf6); }
    .porro-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    td .porro-actions { flex-wrap: nowrap; }
    .porro-actions form { display: inline; margin: 0; }
    .porro-row { display: flex; gap: 12px; align-items: center; padding: 10px 16px; border-top: 1px solid var(--hairline-color, #e3e5e8); flex-wrap: wrap; }
    .porro-row:first-child { border-top: 0; }
    .porro-grow { flex: 1 1 12rem; min-width: 0; }
    .porro-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--hairline-color, #e3e5e8); }
    .porro-form .text { width: auto; }
    .porro-code { margin: 6px 0 0; padding: 8px 12px; border-radius: 4px; background: var(--gray-050, #f3f7fc); white-space: pre-wrap; word-break: break-all; }
    .porro-note { margin: 0; padding: 12px 16px; }
    .porro-protected summary { cursor: pointer; list-style: none; }
    .porro-protected summary::-webkit-details-marker { display: none; }
    .porro-protected summary::before { content: '›'; display: inline-block; width: 12px; transition: transform .15s; }
    .porro-protected[open] summary::before { transform: rotate(90deg); }
    .porro-protected .porro-pane-body p { margin: 0 0 8px; }
    .porro-ranges { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 2px 16px; max-height: 240px; overflow: auto; padding: 8px 12px; border-radius: 4px; background: var(--gray-050, #f3f7fc); font-family: var(--code-font, monospace); font-size: 12px; }
    .porro-kv { display: grid; grid-template-columns: 9rem 1fr; gap: 0 16px; margin: 0; padding: 9px 16px; border-top: 1px solid var(--hairline-color, #e3e5e8); }
    .porro-kv:first-of-type { border-top: 0; }
    .porro-kv dt { color: var(--light-text-color, #606d7b); }
    .porro-kv dd { margin: 0; overflow-wrap: anywhere; }
    .porro-bars { display: flex; align-items: flex-end; gap: 2px; height: 44px; padding: 12px 16px 0; }
    .porro-bars span { flex: 1; min-height: 2px; border-radius: 1px; background: var(--hairline-color, #e3e5e8); }
    .porro-bars span.some { background: var(--warning-color, #c2780b); }
    .porro-bars span.lots { background: var(--error-color, #cf1124); }
    .porro-callout { padding: 12px 16px; border-radius: var(--large-border-radius, 8px); border: 1px solid var(--error-color, #cf1124); color: var(--error-color, #cf1124); }
    .porro-callout.ok { border-color: var(--success-color, #006c45); color: var(--success-color, #006c45); }
    .porro-shared { margin-bottom: 14px; padding: 12px 16px; border-radius: var(--large-border-radius, 8px); border: 1px solid rgb(245 158 11 / .45); background: rgb(245 158 11 / .08); }
    .porro-critical { color: var(--error-color, #cf1124); }
    dialog.porro-confirm { width: min(440px, calc(100vw - 32px)); padding: 0; border: 0; border-radius: var(--large-border-radius, 8px); box-shadow: 0 25px 100px rgba(31, 41, 51, .5); }
    dialog.porro-confirm::backdrop { background: rgba(123, 135, 147, .35); }
    dialog.porro-confirm form { margin: 0; }
    dialog.porro-confirm .body { padding: 24px; }
    dialog.porro-confirm h2 { margin: 0 0 8px; overflow-wrap: anywhere; }
    dialog.porro-confirm p { margin: 0; }
    dialog.porro-confirm .footer { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 24px; border-top: 1px solid var(--hairline-color, #e3e5e8); background: var(--gray-050, #f3f7fc); border-radius: 0 0 var(--large-border-radius, 8px) var(--large-border-radius, 8px); }
    .btn.porro-danger { background-color: var(--error-color, #cf1124); color: #fff; }
    .btn.porro-danger:hover { background-color: #a50e1d; }
    @media (max-width: 640px) { .porro-kv { grid-template-columns: 1fr; } }
{% endcss %}
